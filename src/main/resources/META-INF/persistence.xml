<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="myPU" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>com.example.entity.Dragon</class>
        <class>com.example.entity.Person</class>
        <class>com.example.entity.Coordinates</class>
        <class>com.example.entity.DragonCave</class>
        <class>com.example.entity.DragonHead</class>
        <class>com.example.entity.Location</class>
        <class>com.example.entity.ImportHistory</class>
        <class>com.example.entity.Color</class>
        <class>com.example.entity.Country</class>
        <class>com.example.entity.DragonCharacter</class>
        <class>com.example.entity.ImportStatus</class>

        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <!-- L2 Cache Basic Configuration -->
            <property name="eclipselink.cache.shared.default" value="true"/>
            <property name="eclipselink.cache.type.default" value="SoftWeak"/>
            <property name="eclipselink.cache.size.default" value="1000"/>
            
            <!-- Query Cache -->
            <property name="eclipselink.query-results-cache" value="true"/>
            <property name="eclipselink.query-results-cache.expiry" value="60000"/>
            
            <!-- Enable Cache Statistics -->
            <property name="eclipselink.cache-usage" value="CheckCacheThenDatabase"/>
            <property name="eclipselink.cache.statistics" value="true"/>
            
            <!-- PostgreSQL specific -->
            <property name="eclipselink.target-database" value="PostgreSQL"/>
            <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
            <property name="eclipselink.jdbc.batch-writing.size" value="100"/>
            
            <!-- Logging -->
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.parameters" value="true"/>
            <property name="eclipselink.logging.cache" value="FINE"/>
            
            <!-- Disable DDL generation -->
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>
            
            <!-- JTA properties - важно для Payara -->
            <property name="eclipselink.target-server" value="WebLogic_10"/>
            <property name="eclipselink.jta.platform" value="org.eclipse.persistence.transaction.jta.JTATransactionController"/>
            
            <!-- Для работы с HikariCP через JNDI -->
            <property name="eclipselink.connection-pool.default.initial" value="1"/>
            <property name="eclipselink.connection-pool.default.min" value="3"/>
            <property name="eclipselink.connection-pool.default.max" value="15"/>
        </properties>
    </persistence-unit>
</persistence>
