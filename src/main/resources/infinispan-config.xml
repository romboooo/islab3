<?xml version="1.0" encoding="UTF-8"?>
<infinispan xmlns="urn:infinispan:config:14.0">
    <cache-container name="EclipseLink" default-cache="default">
        <transport cluster="eclipselink-cluster" stack="external"/>

        <local-cache name="default">
            <memory>
                <object size="1000"/>
            </memory>
            <expiration interval="600000" lifespan="600000" max-idle="300000"/>
        </local-cache>

        <local-cache name="entity">
            <memory>
                <object size="2000"/>
            </memory>
            <expiration interval="1200000" lifespan="1200000" max-idle="600000"/>
        </local-cache>

        <local-cache name="query">
            <memory>
                <object size="500"/>
            </memory>
            <expiration interval="300000" lifespan="300000" max-idle="150000"/>
        </local-cache>
    </cache-container>
</infinispan>