<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC
        "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN"
        "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<resources>
    <jdbc-connection-pool name="HikariPostgresPool"
                          datasource-classname="com.zaxxer.hikari.HikariDataSource"
                          res-type="javax.sql.DataSource">
        <property name="jdbcUrl" value="jdbc:postgresql://localhost:5432/studs"/>
        <property name="dataSource.user" value="postgres"/>
        <property name="dataSource.password" value="postgres"/>
        <property name="dataSource.databaseName" value="studs"/>
        <property name="maximumPoolSize" value="20"/>
        <property name="minimumIdle" value="5"/>
        <property name="connectionTimeout" value="30000"/>
        <property name="idleTimeout" value="600000"/>
        <property name="maxLifetime" value="1800000"/>
        <property name="connectionTestQuery" value="SELECT 1"/>
        <property name="leakDetectionThreshold" value="5000"/>
        <property name="poolName" value="HikariPool"/>
    </jdbc-connection-pool>

    <jdbc-resource enabled="true"
                   jndi-name="jdbc/__default"
                   object-type="user"
                   pool-name="HikariPostgresPool"/>
</resources>